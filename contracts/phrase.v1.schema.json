{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offbeat.local/contracts/phrase.v1.schema.json",
  "title": "OFFBEAT music phrase — source-aligned observations v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "source",
    "processing",
    "pitch_frames",
    "onsets",
    "rests",
    "phrases",
    "quality_flags",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "offbeat.phrase.v1"
    },
    "analysis_id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "kind",
        "duration_s",
        "sample_rate_hz",
        "channel_count",
        "mime_type"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "enum": [
            "solo_bass",
            "humming",
            "separated_stem",
            "mixed_reference"
          ]
        },
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 384000
        },
        "channel_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "mime_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_sample_rate_hz",
        "timebase",
        "analyzer_version",
        "pitch_adapter",
        "pitch_model_version",
        "onset_adapter",
        "config_hash",
        "duration_ms"
      ],
      "properties": {
        "analysis_sample_rate_hz": {
          "type": "integer",
          "minimum": 8000
        },
        "timebase": {
          "const": "source_start_seconds"
        },
        "analyzer_version": {
          "type": "string",
          "minLength": 1
        },
        "pitch_adapter": {
          "type": "string",
          "minLength": 1
        },
        "pitch_model_version": {
          "type": "string",
          "minLength": 1
        },
        "onset_adapter": {
          "type": "string",
          "minLength": 1
        },
        "config_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pitch_frames": {
      "type": "array",
      "maxItems": 12000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "t_s",
          "hz",
          "confidence",
          "voiced"
        ],
        "properties": {
          "t_s": {
            "type": "number",
            "minimum": 0
          },
          "hz": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "voiced": {
            "type": "boolean"
          }
        }
      }
    },
    "onsets": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "t_s",
          "strength"
        ],
        "properties": {
          "t_s": {
            "type": "number",
            "minimum": 0
          },
          "strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "rests": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_s",
          "end_s"
        ],
        "properties": {
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "phrases": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_s",
          "end_s",
          "method"
        ],
        "properties": {
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "method": {
            "enum": [
              "rest_boundary",
              "manual"
            ]
          }
        }
      }
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
